generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================= 投流广告 =================

model AdChannel {
  id          String       @id @default(uuid())
  name        String       @unique
  displayName String
  type        String       @default("PAID")
  icon        String       @default("")
  description String       @default("")
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
  createdAt   DateTime     @default(now())
  campaigns   AdCampaign[]
  kols        Kol[]
}

model AdCampaign {
  id          String    @id @default(uuid())
  channelId   String
  name        String
  utmSource   String    @default("")
  utmMedium   String    @default("")
  utmCampaign String    @default("")
  budget      Int       @default(0)
  actualCost  Int       @default(0)
  startAt     DateTime?
  endAt       DateTime?
  status      String    @default("ACTIVE")
  remark      String    @default("")
  createdAt   DateTime  @default(now())
  channel     AdChannel @relation(fields: [channelId], references: [id])
}

model Kol {
  id        String     @id @default(uuid())
  channelId String?
  name      String
  platform  String     @default("")
  contact   String     @default("")
  followers Int        @default(0)
  cost      Int        @default(0)
  promoCode String     @default("")
  promoLink String     @default("")
  isActive  Boolean    @default(true)
  remark    String     @default("")
  createdAt DateTime   @default(now())
  channel   AdChannel? @relation(fields: [channelId], references: [id])
}

// ================= 语言 / 翻译 =================

model Language {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  flag      String   @default("")
  isDefault Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Translation {
  id           String   @id @default(uuid())
  key          String   @unique
  namespace    String   @default("common")
  translations String   @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ================= 卡片发货订单 =================

model CardOrder {
  id              String    @id @default(uuid())
  userId          String
  userName        String    @default("")
  items           String    @default("[]")
  receiverName    String
  receiverPhone   String
  receiverAddress String
  status          String    @default("PENDING")
  trackingNo      String    @default("")
  expressCompany  String    @default("")
  remark          String    @default("")
  adminRemark     String    @default("")
  createdAt       DateTime  @default(now())
  processedAt     DateTime?
  shippedAt       DateTime?
}

// ================= 弹窗 =================

model Popup {
  id              String    @id @default(uuid())
  title           String
  imageUrl        String    @default("")
  content         String    @default("")
  buttonText      String    @default("")
  buttonLink      String    @default("")
  position        String    @default("HOME")
  positionPath    String    @default("")
  delay           Int       @default(0)
  frequency       String    @default("ONCE")
  dailyLimit      Int       @default(1)
  targetVipMin    Int       @default(0)
  targetVipMax    Int       @default(99)
  targetTags      String    @default("")
  targetGroups    String    @default("")
  registerDaysMin Int       @default(0)
  registerDaysMax Int       @default(9999)
  minRecharge     Int       @default(0)
  startAt         DateTime?
  endAt           DateTime?
  isActive        Boolean   @default(true)
  viewCount       Int       @default(0)
  clickCount      Int       @default(0)
  closeCount      Int       @default(0)
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
}

// ================= 文章 =================

model Article {
  id          String   @id @default(uuid())
  slug        String   @unique
  category    String   @default("NEWS")
  title       String
  titleI18n   String   @default("{}")
  coverUrl    String   @default("")
  summary     String   @default("")
  content     String   @default("")
  contentI18n String   @default("{}")
  isPublished Boolean  @default(false)
  sortOrder   Int      @default(0)
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ================= 用户 =================

model User {
  id               String   @id @default(uuid())
  username         String   @unique
  password         String
  coins            Int      @default(10000)
  vipLevel         Int      @default(0)
  totalRecharge    Int      @default(0)
  totalConsume     Int      @default(0)
  groupId          String?
  tags             String   @default("")
  remark           String   @default("")
  lastLoginAt      DateTime @default(now())
  rechargeCount    Int      @default(0)
  withdrawalCount  Int      @default(0)
  withdrawalAmount Int      @default(0)
  createdAt        DateTime @default(now())

  adSource         String   @default("")
  adMedium         String   @default("")
  adCampaign       String   @default("")
  adRef            String   @default("")

  email            String   @default("")
  emailWelcome     Boolean  @default(true)
  emailRecharge    Boolean  @default(true)
  emailVip         Boolean  @default(true)
  emailShip        Boolean  @default(true)
  emailLogs        EmailLog[]

  group            UserGroup?      @relation(fields: [groupId], references: [id])
  inventory        Inventory[]
  orders           Order[]
  userTasks        UserTask[]
  redeemUses       RedeemCodeUse[]
  tickets          Ticket[]
  drawLogs         DrawLog[]
  bankCards        BankCard[]
  transfersFrom    TransferLog[]   @relation("TransfersFrom")
  transfersTo      TransferLog[]   @relation("TransfersTo")
}

model UserGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String   @default("")
  color       String   @default("#6366f1")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  users       User[]
}

model BankCard {
  id         String   @id @default(uuid())
  userId     String
  cardNumber String
  bankName   String   @default("")
  holderName String   @default("")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VipLevel {
  id             String   @id @default(uuid())
  level          Int      @unique
  name           String
  sortOrder      Int      @default(0)
  iconUrl        String   @default("")
  rechargeAmount Int      @default(0)
  consumeAmount  Int      @default(0)
  benefits       String   @default("")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Game {
  id                String   @id @default(uuid())
  name              String   @unique
  displayName       String
  description       String   @default("")
  icon              String   @default("")
  coverUrl          String   @default("")
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  minVipLevel       Int      @default(0)
  minCoins          Int      @default(0)
  allowedRoles      String   @default("")
  enableLeaderboard Boolean  @default(false)
  leaderboardMetric String   @default("CONSUME")
  leaderboardType   String   @default("WEEKLY")
  createdAt         DateTime @default(now())
  boxes             Box[]
}

model Card {
  id            String        @id @default(uuid())
  name          String
  rarity        String
  imageUrl      String        @default("")
  description   String        @default("")
  value         Int           @default(0)
  allowTransfer Boolean       @default(false)
  createdAt     DateTime      @default(now())
  boxItems      BoxItem[]
  inventory     Inventory[]
  transfers     TransferLog[]
}

model Box {
  id            String   @id @default(uuid())
  name          String
  price         Int
  coverUrl      String   @default("")
  description   String   @default("")
  allowTransfer Boolean  @default(false)
  isActive      Boolean  @default(true)
  isFeatured    Boolean  @default(false)
  gameId        String?
  game          Game?    @relation(fields: [gameId], references: [id])
  createdAt     DateTime @default(now())
  items         BoxItem[]
  drawLogs      DrawLog[]
}

model BoxItem {
  id     String @id @default(uuid())
  boxId  String
  cardId String
  weight Int
  box    Box    @relation(fields: [boxId], references: [id], onDelete: Cascade)
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Inventory {
  id       String @id @default(uuid())
  userId   String
  cardId   String
  quantity Int    @default(1)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  card     Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  @@unique([userId, cardId])
}

// ================= 赠送/转让记录 =================

model TransferLog {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  cardId     String
  quantity   Int      @default(1)
  remark     String   @default("")
  createdAt  DateTime @default(now())
  fromUser   User     @relation("TransfersFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("TransfersTo", fields: [toUserId], references: [id], onDelete: Cascade)
  card       Card     @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model RechargeOption {
  id        String   @id @default(uuid())
  coins     Int
  bonus     Int      @default(0)
  price     Int
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id        String         @id @default(uuid())
  userId    String
  optionId  String
  amount    Int
  coins     Int
  status    String         @default("PENDING")
  createdAt DateTime       @default(now())
  paidAt    DateTime?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  option    RechargeOption @relation(fields: [optionId], references: [id])
}

model Withdrawal {
  id          String    @id @default(uuid())
  userId      String
  amount      Int
  bankCardId  String    @default("")
  status      String    @default("PENDING")
  remark      String    @default("")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  type      String
  amount    Int
  balance   Int
  refType   String   @default("")
  refId     String   @default("")
  remark    String   @default("")
  createdAt DateTime @default(now())
}

model PaymentChannel {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  iconUrl     String   @default("")
  config      String   @default("")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Banner {
  id        String   @id @default(uuid())
  imageUrl  String
  link      String   @default("")
  title     String   @default("")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Ad {
  id         String    @id @default(uuid())
  title      String
  imageUrl   String
  linkType   String    @default("URL")
  linkValue  String    @default("")
  position   String    @default("HOME_BANNER")
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  startAt    DateTime?
  endAt      DateTime?
  clickCount Int       @default(0)
  viewCount  Int       @default(0)
  createdAt  DateTime  @default(now())
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String     @default("")
  action      String
  targetCount Int
  rewardCoins Int        @default(0)
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  userTasks   UserTask[]
}

model UserTask {
  id        String   @id @default(uuid())
  userId    String
  taskId    String
  progress  Int      @default(0)
  isClaimed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([userId, taskId])
}

model RedeemCode {
  id        String          @id @default(uuid())
  code      String          @unique
  coins     Int             @default(0)
  maxUses   Int             @default(1)
  usedCount Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  uses      RedeemCodeUse[]
}

model RedeemCodeUse {
  id        String     @id @default(uuid())
  codeId    String
  userId    String
  createdAt DateTime   @default(now())
  code      RedeemCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([codeId, userId])
}

model Ticket {
  id        String        @id @default(uuid())
  userId    String
  title     String
  content   String
  status    String        @default("OPEN")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   TicketReply[]
}

model TicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  fromAdmin Boolean  @default(false)
  content   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model DrawLog {
  id          String   @id @default(uuid())
  userId      String
  boxId       String
  cost        Int
  count       Int      @default(1)
  outputValue Int      @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  box         Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String             @id @default(uuid())
  userId    String?
  title     String
  content   String
  createdAt DateTime           @default(now())
  reads     NotificationRead[]
}

model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  @@unique([notificationId, userId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String   @default("")
  permissions String   @default("")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  admins      Admin[]
}

model Admin {
  id          String         @id @default(uuid())
  username    String         @unique
  password    String
  roleId      String?
  roleRef     Role?          @relation(fields: [roleId], references: [id])
  role        String         @default("admin")
  permissions String         @default("")
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  lastLoginAt DateTime       @default(now())
  sessions    AdminSession[]
}

model AdminSession {
  id           String   @id @default(uuid())
  adminId      String
  adminName    String
  ip           String   @default("")
  userAgent    String   @default("")
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  admin        Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  adminName  String
  action     String
  targetType String   @default("")
  targetId   String   @default("")
  detail     String   @default("")
  ip         String   @default("")
  createdAt  DateTime @default(now())
}

model AdminMenu {
  id         String       @id @default(uuid())
  parentId   String?
  title      String
  type       String       @default("MENU")
  icon       String       @default("")
  path       String       @default("")
  component  String       @default("")
  permission String       @default("")
  sortOrder  Int          @default(0)
  isVisible  Boolean      @default(true)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  parent     AdminMenu?   @relation("MenuChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   AdminMenu[]  @relation("MenuChildren")
}

// ================= 邮件 =================

model EmailLog {
  id        String   @id @default(uuid())
  userId    String?
  toEmail   String
  type      String   // WELCOME / RECHARGE / VIP_UPGRADE / SHIP
  subject   String
  status    String   @default("PENDING") // PENDING / SENT / FAILED
  error     String   @default("")
  createdAt DateTime @default(now())
  sentAt    DateTime?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

model EmailSetting {
  id        String   @id @default("singleton")
  enabled   Boolean  @default(false)
  host      String   @default("")
  port      Int      @default(587)
  secure    Boolean  @default(false)
  user      String   @default("")
  pass      String   @default("")
  fromName  String   @default("LUKA 抽卡平台")
  fromEmail String   @default("")
  updatedAt DateTime @updatedAt
}
