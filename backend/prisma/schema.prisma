generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(uuid())
  username         String   @unique
  password         String
  coins            Int      @default(10000)
  vipLevel         Int      @default(0)
  totalRecharge    Int      @default(0)
  totalConsume     Int      @default(0)
  groupId          String?
  tags             String   @default("")
  remark           String   @default("")
  lastLoginAt      DateTime @default(now())
  rechargeCount    Int      @default(0)
  withdrawalCount  Int      @default(0)
  withdrawalAmount Int      @default(0)
  createdAt        DateTime @default(now())
  group            UserGroup?      @relation(fields: [groupId], references: [id])
  inventory        Inventory[]
  orders           Order[]
  userTasks        UserTask[]
  redeemUses       RedeemCodeUse[]
  tickets          Ticket[]
  drawLogs         DrawLog[]
  bankCards        BankCard[]
}

model UserGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String   @default("")
  color       String   @default("#6366f1")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  users       User[]
}

model BankCard {
  id         String   @id @default(uuid())
  userId     String
  cardNumber String
  bankName   String   @default("")
  holderName String   @default("")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VipLevel {
  id             String   @id @default(uuid())
  level          Int      @unique
  name           String
  sortOrder      Int      @default(0)
  iconUrl        String   @default("")
  rechargeAmount Int      @default(0)
  consumeAmount  Int      @default(0)
  benefits       String   @default("")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
}

model Game {
  id                String   @id @default(uuid())
  name              String   @unique
  displayName       String
  description       String   @default("")
  icon              String   @default("")
  coverUrl          String   @default("")
  sortOrder         Int      @default(0)
  isActive          Boolean  @default(true)
  minVipLevel       Int      @default(0)
  minCoins          Int      @default(0)
  allowedRoles      String   @default("")
  enableLeaderboard Boolean  @default(false)
  leaderboardMetric String   @default("CONSUME")
  leaderboardType   String   @default("WEEKLY")
  createdAt         DateTime @default(now())
  boxes             Box[]
}

model Card {
  id        String      @id @default(uuid())
  name      String
  rarity    String
  imageUrl  String      @default("")
  value     Int         @default(0)
  createdAt DateTime    @default(now())
  boxItems  BoxItem[]
  inventory Inventory[]
}

model Box {
  id         String   @id @default(uuid())
  name       String
  price      Int
  coverUrl   String   @default("")
  isActive   Boolean  @default(true)
  isFeatured Boolean  @default(false)   // 新增：是否在首页推荐
  gameId     String?
  game       Game?    @relation(fields: [gameId], references: [id])
  createdAt  DateTime @default(now())
  items      BoxItem[]
  drawLogs   DrawLog[]
}

model BoxItem {
  id     String @id @default(uuid())
  boxId  String
  cardId String
  weight Int
  box    Box    @relation(fields: [boxId], references: [id], onDelete: Cascade)
  card   Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Inventory {
  id       String @id @default(uuid())
  userId   String
  cardId   String
  quantity Int    @default(1)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  card     Card   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  @@unique([userId, cardId])
}

model RechargeOption {
  id        String   @id @default(uuid())
  coins     Int
  bonus     Int      @default(0)
  price     Int
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  orders    Order[]
}

model Order {
  id        String         @id @default(uuid())
  userId    String
  optionId  String
  amount    Int
  coins     Int
  status    String         @default("PENDING")
  createdAt DateTime       @default(now())
  paidAt    DateTime?
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  option    RechargeOption @relation(fields: [optionId], references: [id])
}

model Withdrawal {
  id          String    @id @default(uuid())
  userId      String
  amount      Int
  bankCardId  String    @default("")
  status      String    @default("PENDING")
  remark      String    @default("")
  createdAt   DateTime  @default(now())
  processedAt DateTime?
}

model Transaction {
  id        String   @id @default(uuid())
  userId    String
  type      String
  amount    Int
  balance   Int
  refType   String   @default("")
  refId     String   @default("")
  remark    String   @default("")
  createdAt DateTime @default(now())
}

model PaymentChannel {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  iconUrl     String   @default("")
  config      String   @default("")
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
}

model Banner {
  id        String   @id @default(uuid())
  imageUrl  String
  link      String   @default("")
  title     String   @default("")
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model Ad {
  id         String    @id @default(uuid())
  title      String
  imageUrl   String
  linkType   String    @default("URL")
  linkValue  String    @default("")
  position   String    @default("HOME_BANNER")
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)
  startAt    DateTime?
  endAt      DateTime?
  clickCount Int       @default(0)
  viewCount  Int       @default(0)
  createdAt  DateTime  @default(now())
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String     @default("")
  action      String
  targetCount Int
  rewardCoins Int        @default(0)
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  userTasks   UserTask[]
}

model UserTask {
  id        String   @id @default(uuid())
  userId    String
  taskId    String
  progress  Int      @default(0)
  isClaimed Boolean  @default(false)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([userId, taskId])
}

model RedeemCode {
  id        String          @id @default(uuid())
  code      String          @unique
  coins     Int             @default(0)
  maxUses   Int             @default(1)
  usedCount Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())
  uses      RedeemCodeUse[]
}

model RedeemCodeUse {
  id        String     @id @default(uuid())
  codeId    String
  userId    String
  createdAt DateTime   @default(now())
  code      RedeemCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([codeId, userId])
}

model Ticket {
  id        String        @id @default(uuid())
  userId    String
  title     String
  content   String
  status    String        @default("OPEN")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   TicketReply[]
}

model TicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  fromAdmin Boolean  @default(false)
  content   String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model DrawLog {
  id          String   @id @default(uuid())
  userId      String
  boxId       String
  cost        Int
  count       Int      @default(1)
  outputValue Int      @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  box         Box      @relation(fields: [boxId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String             @id @default(uuid())
  userId    String?
  title     String
  content   String
  createdAt DateTime           @default(now())
  reads     NotificationRead[]
}

model NotificationRead {
  id             String       @id @default(uuid())
  notificationId String
  userId         String
  readAt         DateTime     @default(now())
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  @@unique([notificationId, userId])
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  displayName String
  description String   @default("")
  permissions String   @default("")
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  admins      Admin[]
}

model Admin {
  id          String         @id @default(uuid())
  username    String         @unique
  password    String
  roleId      String?
  roleRef     Role?          @relation(fields: [roleId], references: [id])
  role        String         @default("admin")
  permissions String         @default("")
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  lastLoginAt DateTime       @default(now())
  sessions    AdminSession[]
}

model AdminSession {
  id           String   @id @default(uuid())
  adminId      String
  adminName    String
  ip           String   @default("")
  userAgent    String   @default("")
  createdAt    DateTime @default(now())
  lastActiveAt DateTime @default(now())
  admin        Admin    @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(uuid())
  adminId    String
  adminName  String
  action     String
  targetType String   @default("")
  targetId   String   @default("")
  detail     String   @default("")
  ip         String   @default("")
  createdAt  DateTime @default(now())
}

model AdminMenu {
  id         String       @id @default(uuid())
  parentId   String?
  title      String
  type       String       @default("MENU")
  icon       String       @default("")
  path       String       @default("")
  component  String       @default("")
  permission String       @default("")
  sortOrder  Int          @default(0)
  isVisible  Boolean      @default(true)
  isActive   Boolean      @default(true)
  createdAt  DateTime     @default(now())
  parent     AdminMenu?   @relation("MenuChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children   AdminMenu[]  @relation("MenuChildren")
}
