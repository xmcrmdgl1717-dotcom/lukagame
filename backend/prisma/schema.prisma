generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  coins     Int      @default(10000)
  inventory Inventory[]
}

model Card {
  id       String   @id @default(uuid())
  name     String
  rarity   String
  imageUrl String
  boxItems BoxItem[]
}

model Box {
  id       String   @id @default(uuid())
  name     String
  price    Int
  coverUrl String
  items    BoxItem[]
}

model BoxItem {
  id       String @id @default(uuid())
  boxId    String
  cardId   String
  weight   Int
  box      Box    @relation(fields: [boxId], references: [id])
  card     Card   @relation(fields: [cardId], references: [id])
}

model Inventory {
  id        String @id @default(uuid())
  userId    String
  cardId    String
  quantity  Int    @default(1)
  user      User   @relation(fields: [userId], references: [id])
  card      Card   @relation(fields: [cardId], references: [id])

  @@unique([userId, cardId])
}
